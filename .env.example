# Nomes provisórios: NUNCA fixar no código (PRD "Regra de nomes")
NEXT_PUBLIC_APP_NAME=Cerco
NEXT_PUBLIC_METHOD_NAME=Método Comitê
# URL base (links de convite e rastreamento). Na Vercel, se vazio, usa a URL do deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: valores de `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SÓ SERVIDOR. Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# IA (a partir do M1; provedor a definir — ver docs/decisoes.md DEC-013)
AI_MODEL_SMART=
AI_MODEL_FAST=

# E-mail transacional
RESEND_API_KEY=
EMAIL_FROM=

# Analytics e erros (no-op se vazio)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Vercel Cron
CRON_SECRET=
